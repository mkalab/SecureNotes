# Local SQL Server and application-encryption secrets.
# Leave blank; ./scripts/init-dev-env.sh generates machine-specific values.
MSSQL_SA_PASSWORD=
NOTES_MIGRATOR_PASSWORD=
NOTES_APP_PASSWORD=
SECURENOTES_KEK=

# Used only by scripts/init-local-db.sh when SQL Server is installed on this machine.
SECURENOTES_SQL_SERVER=localhost,1433
# Optional for DB initialization; defaults to sa/MSSQL_SA_PASSWORD.
# SQL Extended Events need an existing sysadmin login; sa is disabled after initialization.
SECURENOTES_SQL_ADMIN_USER=
SECURENOTES_SQL_ADMIN_PASSWORD=
# Attachment limits for the local Compose API; sizes are bytes.
SECURENOTES_ATTACHMENTS_ENABLED=true
SECURENOTES_ATTACHMENTS_MAX_FILE_BYTES=10485760
SECURENOTES_ATTACHMENTS_MAX_FILES_PER_NOTE=20
SECURENOTES_ATTACHMENTS_MAX_TOTAL_BYTES_PER_USER=104857600
SECURENOTES_SHARING_ENABLED=true

# Optional Google OIDC settings. Leave empty to keep Google sign-in disabled.
GOOGLE_OIDC_CLIENT_ID=
GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://localhost:5173/signin-oidc
GOOGLE_OIDC_FRONTEND_ORIGIN=http://localhost:5173

# Set only when running behind a trusted reverse proxy.
SECURENOTES_TRUSTED_PROXY_IPS=

# Optional future production settings; not needed for the group-machine demo.
# Used by:
# docker compose -f docker-compose.yml -f docker-compose.production.yml up --build -d
# Use a private, non-overlapping subnet and reserve the proxy IP inside that subnet.
SECURENOTES_PROD_SUBNET=
SECURENOTES_PROXY_IP=
# Must match the DNS name in the SQL Server certificate SAN.
SECURENOTES_DB_HOST=
SECURENOTES_SQL_TLS_CERT_PATH=
SECURENOTES_SQL_TLS_KEY_PATH=
SECURENOTES_WEB_TLS_CERT_PATH=
SECURENOTES_WEB_TLS_KEY_PATH=
SECURENOTES_HTTP_PORT=80
SECURENOTES_HTTPS_PORT=443
SECURENOTES_PRODUCTION_ORIGIN=
