FROM node:22-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci

COPY . .
RUN npm run build \
    && if find dist -type f \( -name '*.map' -o -name '*.bak' -o -name '*.old' \) -print -quit | grep -q .; then \
        echo "Production frontend contains a source map or backup file." >&2; exit 1; \
    fi

FROM nginxinc/nginx-unprivileged:stable-alpine AS runtime
USER root
RUN mkdir -p /etc/nginx/tls && chown 101:101 /etc/nginx/tls
COPY --from=build /app/dist /usr/share/nginx/html
COPY nginx.production.conf /etc/nginx/conf.d/default.conf
USER 101:101
EXPOSE 8080 8443
